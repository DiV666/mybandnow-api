generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================================================================
// 1. CONTEXTO MYBANDNOW (Aplicación principal / autenticación)
// =========================================================================
model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  musician  Musician?
}

// =========================================================================
// 2. CONTEXTO MOAT (Core de negocio musical)
// =========================================================================
model Musician {
  id              String           @id @default(uuid())
  username        String           @unique
  realName        String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String           @unique
  instruments     String[]
  bandsOwned      Band[]           @relation("BandOwner")
  bandMembers     BandMember[]
  songInstruments SongInstrument[]
}

model Instruments {
  id          String   @id @default(uuid())
  name        String
  description String
  createdAt   DateTime @default(now())

  @@index([name])
  @@index([createdAt])
}

model Band {
  id        String       @id @default(uuid())
  name      String
  owner     Musician     @relation("BandOwner", fields: [ownerId], references: [id])
  ownerId   String
  members   BandMember[]
  songs     Song[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([ownerId])
}

model BandMember {
  id         String   @id @default(uuid())
  role       String   @default("MEMBER") // ADMIN | MEMBER | PLAYING_COACH
  musician   Musician @relation(fields: [musicianId], references: [id])
  musicianId String
  band       Band     @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId     String

  @@unique([musicianId, bandId])
}

model Song {
  id                    String                 @id @default(uuid())
  title                 String
  band                  Band                   @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId                String
  originalVideoclipUrl  String
  songInstrumentUploads SongInstrumentUpload[]
  songInstruments       SongInstrument[]
  videoclip             Videoclip?

  @@index([bandId])
  @@index([title])
  @@index([bandId, title])
}

model SongInstrument {
  id                    String                 @id @default(uuid())
  name                  String
  instrumentType        String
  song                  Song                   @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId                String
  musician              Musician               @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  musicianId            String
  songInstrumentUploads SongInstrumentUpload[] @relation("SongInstrumentUploadAttempts")
  activeUploadAttemptId String?                @unique
  activeUploadAttempt   SongInstrumentUpload?  @relation("SongInstrumentActiveUploadAttempt", fields: [activeUploadAttemptId], references: [id], onDelete: SetNull)
  songInstrumentVideo   SongInstrumentVideo?
  createdAt             DateTime               @default(now())

  @@index([songId])
  @@index([songId, musicianId])
  @@index([songId, instrumentType])
  @@index([songId, name])
  @@index([songId, createdAt])
}

model SongInstrumentVideo {
  id               String         @id @default(uuid())
  songInstrument   SongInstrument @relation(fields: [songInstrumentId], references: [id], onDelete: Cascade)
  songInstrumentId String         @unique
  url              String
  duration         Int
  size             Int
  createdAt        DateTime       @default(now())
}

model SongInstrumentUpload {
  id                      String          @id @default(uuid())
  instrumentName          String
  status                  String          @default("PENDING") // PENDING | READY | PROCESSING | FAILED
  song                    Song            @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId                  String
  songInstrument          SongInstrument  @relation("SongInstrumentUploadAttempts", fields: [songInstrumentId], references: [id], onDelete: Cascade)
  songInstrumentId        String
  activeForSongInstrument SongInstrument? @relation("SongInstrumentActiveUploadAttempt")
  errorMessage            String?
  createdAt               DateTime        @default(now())

  @@index([songInstrumentId])
}

model Videoclip {
  id        String   @id @default(uuid())
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId    String   @unique
  isPublic  Boolean  @default(false)
  url       String // GCS path to the final video
  duration  Int // Duration in seconds
  size      Int // File size in bytes
  createdAt DateTime @default(now())
}

// =========================================================================
// 3. CONTEXTO ORCHESTRATOR (Infraestructura Técnica / Saga Asíncrona)
// =========================================================================

model SongInstrumentProcess {
  id         String   @id // Shares the exact ID of the SongInstrumentUpload attempt (Moat)
  status     String   @default("COMPLETED") // COMPLETED | FAILED
  gcsPath    String? // Ruta en GCS (e.g. bands/:bandId/songs/:songId/tracks/:trackId.mp4)
  fileSize   Int?
  codec      String? // Extraído por ffprobe (debe ser h264)
  ffprobeLog Json? // Metadatos y logs técnicos estructurados
  updatedAt  DateTime @updatedAt
}

model VideoclipProcess {
  id           String   @id // Comparte exactamente el ID del modelo Videoclip (Moat)
  status       String   @default("PENDING") // PENDING | MIXING | SUCCESS | FAILED | TIMEOUT
  aiPayload    Json? // Snapshot denormalizado enviado al worker de IA
  aiResponse   Json? // Registro de logs e intercambio con la IA
  finalGcsPath String? // Ruta inmutable del videoclip generado en GCS
  startedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// =========================================================================
// 4. CONTEXTO SHARED (RabbitMQ Failover & Outbox)
// =========================================================================
model Outbox {
  id           String    @id @default(uuid())
  eventId      String
  eventName    String
  aggregateId  String
  occurredOn   DateTime
  payload      Json
  status       String    @default("pending")
  attempts     Int       @default(0)
  createdAt    DateTime  @default(now())
  publishedAt  DateTime?
  errorMessage String?

  @@index([status, createdAt])
}

model DomainEventFailover {
  eventId     String   @id
  aggregateId String
  eventName   String
  payload     Json
  occurredOn  DateTime @default(now())
}
