{
  "name": "mybandnow-api",
  "description": "Mybandnow REST API",
  "version": "0.0.1",
  "author": "KLODING",
  "license": "SEE LICENSE IN LICENSE FILE",
  "type": "module",
  "scripts": {
    "prepare": "husky install",
    "start": "node dist/start.js",
    "development:start": "del-cli dist && node esbuild.config.js && npm run build:cp-yaml-files & nodemon",
    "development:watch": "node esbuild.config.js --watch & nodemon | bunyan -o short",
    "development:update-version": "node build-tools/update-version.js",
    "git:pre-commit": "npm run format:fix",
    "format": "eslint '{src,test}/**/*.{js,ts,tsx}'",
    "format:fix": "npm run format -- --fix",
    "tests": "npm run tests:unit && npm run tests:integration && npm run tests:acceptance",
    "tests:acceptance": "cucumber-js",
    "tests:acceptance:coverage": "c8 --reports-dir=./.coverage-tmp/tests/acceptance --reporter=json npm run tests:acceptance",
    "tests:integration": "NODE_ENV=test vitest run --project integration",
    "tests:unit": "NODE_ENV=test vitest run --project unit",
    "build:tests": "del-cli reports/coverage && NODE_ENV=test vitest run --coverage",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json",
    "build:docs": "del-cli docs/typedoc && typedoc",
    "build": "del-cli dist && npm run format:fix && npm run typecheck && npm run build:docs && node esbuild.config.js && npm run build:cp-yaml-files && npm run build:prepare-publish-files",
    "build:cp-yaml-files": "cpx \"src/**/*.yaml\" dist/",
    "build:prepare-publish-files": "node build-tools/prepare-publish-files.js"
  },
  "repository": {
    "type": "git",
    "url": "https://bitbucket.org/kloding-dev/mybandnow-api.git"
  },
  "overrides": {
    "form-data": "4.0.6"
  },
  "dependencies": {
    "@google-cloud/storage": "7.21.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@sentry/node": "10.57.0",
    "ajv-formats": "3.0.1",
    "amqplib": "2.0.1",
    "axios": "1.17.0",
    "bcryptjs": "3.0.3",
    "bunyan": "1.8.15",
    "cors": "2.8.6",
    "express": "5.2.1",
    "fluent-ffmpeg": "2.1.3",
    "helmet": "8.2.0",
    "http-status": "2.1.0",
    "jsonwebtoken": "9.0.3",
    "jwks-rsa": "4.0.1",
    "node-dependency-injection": "3.6.2",
    "openapi-backend": "5.17.0",
    "pg": "8.21.0",
    "uuid": "14.0.0",
    "uuid-validate": "0.0.3",
    "yamljs": "0.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.0.0",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.4.0",
    "@types/bcryptjs": "2.4.6",
    "@types/bunyan": "1.8.11",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/dot-object": "2.1.6",
    "@types/express": "5.0.6",
    "@types/fluent-ffmpeg": "2.1.28",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.9.3",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.0",
    "@types/uuid": "10.0.0",
    "@types/uuid-validate": "0.0.3",
    "@types/yamljs": "0.2.34",
    "@typescript-eslint/eslint-plugin": "8.61.0",
    "@typescript-eslint/parser": "8.61.0",
    "@vitest/coverage-v8": "4.1.8",
    "c8": "11.0.0",
    "cpx": "1.5.0",
    "del-cli": "7.0.0",
    "dot-object": "2.1.5",
    "esbuild": "0.28.1",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-sonarjs": "4.0.3",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "nodemon": "3.1.14",
    "prettier": "3.8.4",
    "prisma": "7.8.0",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "tsconfig-paths": "4.2.0",
    "typedoc": "0.28.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "vite": "8.0.16",
    "vitest": "4.1.8",
    "vitest-mock-extended": "4.0.0"
  }
}
