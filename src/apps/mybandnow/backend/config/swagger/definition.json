{
    "openapi": "3.1.0",
    "info": {
        "description": "Collaborative platform for the automated creation of music videos for music groups.",
        "version": "1.4.0",
        "title": "Mybandnow API",
        "termsOfService": "https://kloding.com",
        "contact": {
            "email": "developers@kloding.com"
        },
        "license": {
            "name": "No license",
            "url": "https://choosealicense.com/no-permission/"
        }
    },
    "tags": [
        {
            "name": "Mybandnow",
            "description": "REST API that allows you to do a mybandnow"
        }
    ],
    "servers": [
        {
            "url": "{protocol}://{host}:{port}",
            "description": "Dynamic server to multiples environments",
            "variables": {
                "protocol": {
                    "default": "http",
                    "enum": [
                        "http",
                        "https"
                    ],
                    "description": "The protocol to use"
                },
                "host": {
                    "default": "localhost",
                    "description": "The host to use"
                },
                "port": {
                    "default": "4008",
                    "description": "The port to use"
                }
            }
        }
    ],
    "paths": {
        "/v1/users/register": {
            "post": {
                "security": [],
                "operationId": "userPostRegister",
                "tags": [
                    "User"
                ],
                "summary": "Custom action userPostRegister",
                "description": "Execute userPostRegister",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": "string",
                                        "format": "uuid"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string",
                                        "minLength": 8
                                    }
                                },
                                "required": [
                                    "id",
                                    "email",
                                    "password"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created"
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "409": {
                        "$ref": "#/components/responses/Conflict"
                    },
                    "500": {
                        "$ref": "#/components/responses/Unknown"
                    }
                }
            }
        },
        "/v1/users/login": {
            "post": {
                "security": [],
                "operationId": "userPostLogin",
                "tags": [
                    "User"
                ],
                "summary": "Custom action userPostLogin",
                "description": "Execute userPostLogin",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string",
                                        "minLength": 8
                                    }
                                },
                                "required": [
                                    "email",
                                    "password"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Success"
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "409": {
                        "$ref": "#/components/responses/Conflict"
                    },
                    "500": {
                        "$ref": "#/components/responses/Unknown"
                    }
                }
            }
        },
        "/v1/profile": {
            "post": {
                "tags": [
                    "Mybandnow"
                ],
                "summary": "Create musician profile",
                "operationId": "profilePost",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/MusicianCreateRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created"
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "409": {
                        "$ref": "#/components/responses/Conflict"
                    }
                }
            },
            "get": {
                "tags": [
                    "Mybandnow"
                ],
                "summary": "Get authenticated user profile",
                "operationId": "profileGet",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MusicianResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Forbidden"
                    }
                }
            }
        },
        "/v1/musicians/{id}": {
            "get": {
                "tags": [
                    "Mybandnow"
                ],
                "summary": "Get musician by id",
                "operationId": "musicianGetById",
                "security": [],
                "parameters": [
                    {
                        "$ref": "#/components/parameters/Id"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MusicianResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    }
                }
            }
        },
        "/v1/songs/{songId}/instruments/{instrumentId}/upload": {
            "post": {
                "tags": [
                    "Track"
                ],
                "summary": "Upload a track video for asynchronous validation",
                "description": "Send the multipart/form-data field named video with an MP4 file for a specific song instrument participation.",
                "operationId": "trackPostUpload",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "songId",
                        "in": "path",
                        "required": true,
                        "description": "Song identifier",
                        "schema": {
                            "$ref": "#/components/schemas/UUID"
                        }
                    },
                    {
                        "name": "instrumentId",
                        "in": "path",
                        "required": true,
                        "description": "Song instrument identifier",
                        "schema": {
                            "$ref": "#/components/schemas/UUID"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "video"
                                ],
                                "properties": {
                                    "video": {
                                        "type": "string",
                                        "format": "binary",
                                        "description": "MP4 video file uploaded in the video field"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "Accepted"
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    }
                }
            }
        },
        "/v1/songs/{songId}/instruments": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "operationId": "songInstrumentPostCreate",
                "tags": [
                    "SongInstrument"
                ],
                "summary": "Create a song instrument",
                "description": "Create a song instrument for a song owned by the authenticated musician. The musicianId in the body must match that owner's musician profile.",
                "parameters": [
                    {
                        "name": "songId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/UUID"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/SongInstrumentCreateRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "The song instrument has been created"
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "409": {
                        "$ref": "#/components/responses/Conflict"
                    },
                    "500": {
                        "$ref": "#/components/responses/Unknown"
                    }
                }
            }
        },
        "/v1/bands": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "operationId": "bandPostCreate",
                "tags": [
                    "Band"
                ],
                "summary": "Create a band",
                "description": "Create a band",
                "requestBody": {
                    "description": "A JSON object containing band information",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "$ref": "#/components/schemas/UUID"
                                    },
                                    "name": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "id",
                                    "name"
                                ],
                                "additionalProperties": false
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "The band has been created"
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "409": {
                        "$ref": "#/components/responses/Conflict"
                    },
                    "500": {
                        "$ref": "#/components/responses/Unknown"
                    }
                }
            },
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "operationId": "bandGetMatchByCriteria",
                "tags": [
                    "Band"
                ],
                "summary": "Get a list of band by criteria",
                "description": "Get a list of band by criteria",
                "parameters": [
                    {
                        "name": "criteria",
                        "in": "query",
                        "required": false,
                        "description": "A JSON object for filtering, sorting, and pagination. Example: `{\"filters\":[{\"field\":\"name\",\"operator\":\"CONTAINS\",\"value\":\"test\"}],\"orderBy\":\"name\",\"order\":\"asc\",\"limit\":10,\"offset\":0}`",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A list of band"
                    },
                    "500": {
                        "$ref": "#/components/responses/Unknown"
                    }
                }
            }
        },
        "/v1/bands/{id}": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "operationId": "bandPutUpdate",
                "tags": [
                    "Band"
                ],
                "summary": "Update a band",
                "description": "Update a band",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/UUID"
                        }
                    }
                ],
                "requestBody": {
                    "description": "A JSON object containing the fields to update",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "name"
                                ],
                                "additionalProperties": false
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The band has been updated"
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "500": {
                        "$ref": "#/components/responses/Unknown"
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "operationId": "bandDeleteRemove",
                "tags": [
                    "Band"
                ],
                "summary": "Remove a band",
                "description": "Remove a band by ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/UUID"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "The band has been removed"
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "500": {
                        "$ref": "#/components/responses/Unknown"
                    }
                }
            },
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "operationId": "bandGetSearch",
                "tags": [
                    "Band"
                ],
                "summary": "Get a band by ID",
                "description": "Get a band by ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/UUID"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The band found"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "500": {
                        "$ref": "#/components/responses/Unknown"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "BearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            },
            "InternalAuth": {
                "type": "apiKey",
                "in": "header",
                "name": "x-internal-auth"
            }
        },
        "responses": {
            "BadRequest": {
                "description": "Bad request. Invalid data received.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "NotFound": {
                "description": "The specified resource was not found.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "Conflict": {
                "description": "The specified resource has a conflict.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "Forbidden": {
                "description": "Forbidden.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "Unknown": {
                "description": "Unknown error",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            }
        },
        "requestBodies": {},
        "parameters": {
            "Criteria": {
                "name": "criteria",
                "in": "query",
                "schema": {
                    "type": "string",
                    "example": "{\"filters\":[{\"field\":\"name\",\"operator\":\"CONTAINS\",\"type\":\"array\",\"value\":[\"John\"]}],\"orderBy\":\"role\",\"order\":\"asc\",\"limit\":3}"
                }
            },
            "Id": {
                "name": "id",
                "in": "path",
                "required": true,
                "description": "The UUID id",
                "schema": {
                    "$ref": "#/components/schemas/UUID"
                }
            }
        },
        "schemas": {
            "UUID": {
                "type": "string",
                "format": "uuid",
                "example": "30437b49-faac-4ab1-9809-037ce93cb6d0"
            },
            "Error": {
                "title": "The error object",
                "required": [
                    "message"
                ],
                "properties": {
                    "message": {
                        "type": "string"
                    }
                }
            },
            "BandMemberResponse": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "musicianId",
                    "role"
                ],
                "properties": {
                    "id": {
                        "$ref": "#/components/schemas/UUID"
                    },
                    "musicianId": {
                        "$ref": "#/components/schemas/UUID"
                    },
                    "role": {
                        "type": "string"
                    }
                }
            },
            "MusicianCreateRequest": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "name",
                    "username"
                ],
                "properties": {
                    "id": {
                        "$ref": "#/components/schemas/UUID"
                    },
                    "name": {
                        "type": "string"
                    },
                    "username": {
                        "type": "string"
                    }
                }
            },
            "MusicianResponse": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "name",
                    "username"
                ],
                "properties": {
                    "id": {
                        "$ref": "#/components/schemas/UUID"
                    },
                    "name": {
                        "type": "string"
                    },
                    "username": {
                        "type": "string"
                    }
                }
            },
            "SongInstrumentCreateRequest": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "name",
                    "instrumentType",
                    "musicianId"
                ],
                "properties": {
                    "id": {
                        "$ref": "#/components/schemas/UUID"
                    },
                    "name": {
                        "type": "string"
                    },
                    "instrumentType": {
                        "type": "string"
                    },
                    "musicianId": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/UUID"
                            }
                        ],
                        "description": "Must match the authenticated song owner's musician profile. Cross-musician assignment is not allowed in this flow."
                    }
                }
            }
        }
    }
}
