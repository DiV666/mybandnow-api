{
  "openapi": "3.1.0",
  "info": {
    "description": "Collaborative platform for the automated creation of music videos for music groups.",
    "version": "1.4.0",
    "title": "Mybandnow API",
    "termsOfService": "https://kloding.com",
    "contact": {
      "email": "developers@kloding.com"
    },
    "license": {
      "name": "No license",
      "url": "https://choosealicense.com/no-permission/"
    }
  },
  "tags": [
    {
      "name": "Mybandnow",
      "description": "REST API that allows you to do a mybandnow"
    }
  ],
  "servers": [
    {
      "url": "{protocol}://{host}:{port}",
      "description": "Dynamic server to multiples environments",
      "variables": {
        "protocol": {
          "default": "http",
          "enum": [
            "http",
            "https"
          ],
          "description": "The protocol to use"
        },
        "host": {
          "default": "localhost",
          "description": "The host to use"
        },
        "port": {
          "default": "4008",
          "description": "The port to use"
        }
      }
    }
  ],
  "paths": {
    "/v1/users/register": {
      "post": {
        "security": [],
        "operationId": "userPostRegister",
        "tags": [
          "User"
        ],
        "summary": "Custom action userPostRegister",
        "description": "Execute userPostRegister",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8
                  }
                },
                "required": [
                  "id",
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/Unknown"
          }
        }
      }
    },
    "/v1/users/login": {
      "post": {
        "security": [],
        "operationId": "userPostLogin",
        "tags": [
          "User"
        ],
        "summary": "Custom action userPostLogin",
        "description": "Execute userPostLogin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/Unknown"
          }
        }
      }
    },
    "/v1/profile": {
      "post": {
        "tags": [
          "Mybandnow"
        ],
        "summary": "Create musician profile",
        "operationId": "profilePost",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MusicianCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "401": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "get": {
        "tags": [
          "Mybandnow"
        ],
        "summary": "Get authenticated user profile",
        "operationId": "profileGet",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MusicianResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "InternalAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-auth"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request. Invalid data received.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "The specified resource was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "The specified resource has a conflict.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Forbidden.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unknown": {
        "description": "Unknown error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "requestBodies": {},
    "parameters": {
      "Criteria": {
        "name": "criteria",
        "in": "query",
        "schema": {
          "type": "string",
          "example": "{\"filters\":[{\"field\":\"name\",\"operator\":\"CONTAINS\",\"type\":\"array\",\"value\":[\"John\"]}],\"orderBy\":\"role\",\"order\":\"asc\",\"limit\":3}"
        }
      },
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The UUID id",
        "schema": {
          "$ref": "#/components/schemas/UUID"
        }
      }
    },
    "schemas": {
      "UUID": {
        "type": "string",
        "format": "uuid",
        "example": "30437b49-faac-4ab1-9809-037ce93cb6d0"
      },
      "Error": {
        "title": "The error object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "BandMemberResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "musicianId",
          "role"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/UUID"
          },
          "musicianId": {
            "$ref": "#/components/schemas/UUID"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "MusicianCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "username"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/UUID"
          },
          "name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "MusicianResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "userId",
          "name",
          "username"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/UUID"
          },
          "userId": {
            "$ref": "#/components/schemas/UUID"
          },
          "name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      }
    }
  }
}
